---
import { API_BASE } from '../../lib/apiBase.js';
import { slugify } from '../../lib/slugify.js';
import WorkDetailContent from '../../components/display/workdetailcontent.jsx';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const response = await fetch(`${API_BASE}/works`);
  if (!response.ok) {
    throw new Error(`Could not load works while building pages (${response.status})`);
  }
  const works = await response.json();
  const seen = new Set();

  return works.flatMap((work) => {
    const name = slugify(work.work_title);
    if (!name || seen.has(name)) return [];
    seen.add(name);
    return [{ params: { name }, props: { work } }];
  });
}

const { work } = Astro.props;
---

<Layout title={work.work_title}>
  <WorkDetailContent work={work} client:load />
</Layout>

---
import { API_BASE } from '../../lib/apiBase.js';
import { slugify } from '../../lib/slugify.js';
import BlogDetailContent from '../../components/display/blogdetailcontent.jsx';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const response = await fetch(`${API_BASE}/blogs`);
  if (!response.ok) {
    throw new Error(`Could not load blogs while building pages (${response.status})`);
  }
  const blogs = await response.json();
  const seen = new Set();

  return blogs.flatMap((blog) => {
    const name = slugify(blog.slug || blog.title);
    if (!name || seen.has(name)) return [];
    seen.add(name);
    return [{ params: { name }, props: { blog } }];
  });
}

const { blog } = Astro.props;
---

<Layout title={blog.title}>
  <BlogDetailContent blog={blog} client:load />
</Layout>
